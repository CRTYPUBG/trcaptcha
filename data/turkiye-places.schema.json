{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trCAPTCHA places",
  "type": "object",
  "required": ["version", "places"],
  "properties": {
    "version": { "type": "string" },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "imageUrl", "source", "license", "isTurkish", "tags", "difficulty"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "city": { "type": "string" },
          "region": { "type": "string" },
          "imageUrl": { "type": "string", "format": "uri" },
          "source": { "enum": ["wikimedia", "unsplash", "pexels"] },
          "license": { "type": "string" },
          "author": { "type": "string" },
          "isTurkish": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
